{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "declaration": false,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["electron", "vite.config.ts"]
}
